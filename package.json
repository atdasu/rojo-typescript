{
  "name": "starter-game",
  "version": "0.1.0",
  "private": true,
  "description": "A Roblox game scaffold using roblox-ts, Rojo, Rokit, and Wally.",
  "packageManager": "pnpm@11.9.0",
  "roblox": {
    "runtimeNpmScopes": [
      "@rbxts",
      "@starter"
    ],
    "internalLibraryScope": "@starter"
  },
  "scripts": {
    "build": "node tools/sync-internal-libraries.mjs && rbxtsc",
    "watch": "concurrently --kill-others-on-fail --names rbxtsc,rojo --prefix-colors blue,green \"pnpm watch:rbxts\" \"pnpm watch:rojo\"",
    "watch:rbxts": "rbxtsc --watch",
    "watch:rojo": "rojo serve default.project.json",
    "lint": "eslint src libraries --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run deps:check && pnpm run build",
    "deps:check": "node tools/check-runtime-dependencies.mjs",
    "wally:install": "wally install && node tools/ensure-wally-directories.mjs",
    "place:build": "pnpm run build && node tools/ensure-build-directory.mjs && rojo build default.project.json --output build/StarterGame.rbxl"
  },
  "dependencies": {
    "@starter/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "1.0.940",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-roblox-ts": "1.4.1",
    "prettier": "3.9.6",
    "roblox-ts": "3.0.0",
    "typescript": "5.5.3",
    "typescript-eslint": "8.63.0"
  }
}
