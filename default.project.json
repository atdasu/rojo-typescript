{
  "name": "StarterGame",
  "globIgnorePaths": ["**/*.spec.lua"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Packages": {
        "$path": "Packages"
      },
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$path": "node_modules/@rbxts"
        }
      },
      "$path": "out/shared"
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "out/server"
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "out/client"
      }
    }
  }
}
