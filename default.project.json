{
  "name": "StarterGame",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "out/shared"
      },
      "Packages": {
        "$className": "Folder",
        "$ignoreUnknownInstances": false,
        "$path": { "optional": "Packages" }
      },
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "out/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "ServerPackages": {
        "$className": "Folder",
        "$ignoreUnknownInstances": false,
        "$path": { "optional": "ServerPackages" }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "out/client"
        }
      }
    }
  }
}
